<h1>Find a Flight</h1>

<%= form_with(url: "/index", method: "get") do %>
  <%= label_tag(:departure_airport, "Origin:") %>
  <%= select_tag(:departure_airport, options_for_select(@airports)) %>
  <%= label_tag(:arrival_airport, "Destination:") %>
  <%= select_tag(:arrival_airport, options_for_select(@airports)) %>
  <%= label_tag(:departure_time, "Departure date:")%>
  <%= select_tag(:departure_time, options_for_select(@dates)) %>
  <%= label_tag(:passenger_count, "Number of passengers:") %>
  <%= select_tag(:passenger_count, options_for_select(1..4)) %>
  <%= submit_tag("Search") %>
<% end %>

<% if @flights && @flights.any? %>
  <%= form_with(url: new_booking_path, method: :get) do |form| %>
    <% @flights.each do |flight| %>
      <%= form.radio_button :flight_id, flight.id %>
      <%= form.label :flight_id do %>
        <ul>
          <li>
            Departure airport: <%= flight.departure_airport.name %>
          </li>
          <li>
            Arrival airport: <%= flight.arrival_airport.name %>
          </li>
          <li>
            Departure time: <%= flight.departure_time %>
          </li>
          <li>
            Arrival time: <%= flight.arrival_time %>
          </li>
          <li>
            Duration: <%= flight.duration / 60 %> hours <%= flight.duration % 60 %> minutes
          </li>
        </ul>
      <% end %>
    <% end %>
    <%= form.hidden_field :passenger_count, value: params[:passenger_count] %>
    <%= form.submit "Select Flight" %>
  <% end %>
<% end %>