<h1>New Booking</h1>

<ul id="info">
  <li>
    Departing from: <%= @flight.departure_airport.name %>
  </li>
  <li>
    Departure time: <%= @flight.departure_time %>
  </li>
  <li>
    Arriving at: <%= @flight.arrival_airport.name %>
  </li>
  <li>
    Arrival time: <%= @flight.arrival_time %>
  </li>
</ul>

<%= form_with model: @booking do |form| %>
  <%= form.fields_for :passengers do |f, index| %>
    <h3>Guest <%= f.index + 1 %></h3>
    <%= f.label :name %>
    <%= f.text_field :name %>
    <%= f.label :email %>
    <%= f.text_field :email %>
  <% end %>
  <%= form.hidden_field :passenger_count, value: @passenger_count %>
  <%= form.hidden_field :flight_id, value: @flight_id %>
  <%= form.submit %>
<% end %>