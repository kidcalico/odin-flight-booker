<h1>New Booking</h1>
<p>Find me in app/views/bookings/new.html.erb</p>

<ul id="info">
  <li>
    Departing from: <%= @flight.departure_airport.name %>
  </li>
  <li>
    Departure time: <%= @flight.departure_time %>
  </li>
  <li>
    Arriving at: <%= @flight.arrival_airport.name %>
  </li>
  <li>
    Arrival time: <%= @flight.arrival_time %>
  </li>
</ul>

<%= form_with model: @booking do |form| %>
  <%= form.fields_for :passengers do |f| %>
    <%= f.label :name %>
    <%= f.text_field :name %>
    <%= f.label :email %>
    <%= f.text_field :email %>
  <% end %>
  <%= form.submit %>
<% end %>